# Copy this file to .env and fill in the values.
# Variables must start with VITE_ to be exposed to the browser bundle.
# Never commit your real .env file.

# Base URL for the Laravel API — no trailing slash.
# Example: http://localhost:8000/api
VITE_API_BASE_URL=http://localhost:8000/api

# ─── Laravel backend setup checklist ─────────────────────────────────────────
# 1. CORS: in config/cors.php set allowed_origins to include your Vite dev URL
#    (typically http://localhost:5173). For production, set it to your domain.
#
# 2. Auth: this project uses token-based auth (Laravel Sanctum recommended).
#    Install: composer require laravel/sanctum
#    Publish config: php artisan vendor:publish --provider="Laravel\Sanctum\SanctumServiceProvider"
#    In your User model, add the HasApiTokens trait.
#
# 3. Ensure your API routes are prefixed with /api in routes/api.php.
